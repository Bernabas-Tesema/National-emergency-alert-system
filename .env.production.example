# Copy to .env.production (or export these) before:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Shared secrets (generate long random values) ---
POSTGRES_PASSWORD=change-this-db-password
DJANGO_SECRET_KEY=replace-with-50-plus-char-random-string
JWT_SECRET=replace-with-40-plus-char-random-string
AI_SERVICE_KEY=replace-with-32-plus-char-shared-ai-key

# --- Hosting ---
POSTGRES_DB=ethioalert
POSTGRES_USER=ethioalert
ALLOWED_HOSTS=api.yourdomain.gov.et,localhost
CORS_ORIGINS=https://console.yourdomain.gov.et
CSRF_TRUSTED_ORIGINS=https://console.yourdomain.gov.et,https://api.yourdomain.gov.et
FRONTEND_URL=https://console.yourdomain.gov.et
API_PUBLISH_PORT=8081

# Behind a TLS-terminating reverse proxy set true; for plain Docker HTTP keep false.
SECURE_SSL_REDIRECT=false

# --- Email (staff OTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.gov.et
STAFF_FALLBACK_OTP_EMAIL=ops@yourdomain.gov.et

# --- AI providers (at least one for AI_MODE=live) ---
AI_MODE=live
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
AI_PROVIDER_ORDER=groq,openrouter,cerebras
