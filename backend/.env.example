DATABASE_URL=sqlite:///./django_alerts.db
JWT_SECRET=replace-this-with-a-long-random-secret
DJANGO_SECRET_KEY=django-dev-secret-change-me
ACCESS_TOKEN_MINUTES=30
OTP_MINUTES=5
DEV_MODE=true
ALLOWED_HOSTS=127.0.0.1,localhost
STAFF_ADMIN_PASSWORD=change-me
STAFF_OFFICER_PASSWORD=change-me
DJANGO_ADMIN_PASSWORD=change-me
STAFF_FALLBACK_OTP_EMAIL=your-gmail@gmail.com
PLATFORM_NAME=EthioAlert
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=your-gmail@gmail.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Flutter web: DEV_MODE also allows any http://localhost:<port> / 127.0.0.1 via regex.
AI_SERVICE_URL=http://127.0.0.1:8088
AI_SERVICE_KEY=ethioalert-ai-local-dev-key
# Production: see .env.production.example and DEPLOY.md
