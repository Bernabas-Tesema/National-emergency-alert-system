# Production template for Django API (standalone or Docker).
# Never commit real secrets.

DEV_MODE=false
DJANGO_SECRET_KEY=replace-with-50-plus-char-random-string
JWT_SECRET=replace-with-40-plus-char-random-string
DATABASE_URL=postgres://ethioalert:STRONG_DB_PASSWORD@db:5432/ethioalert
REDIS_URL=redis://redis:6379/0

ALLOWED_HOSTS=api.yourdomain.gov.et
CORS_ORIGINS=https://console.yourdomain.gov.et
CSRF_TRUSTED_ORIGINS=https://console.yourdomain.gov.et,https://api.yourdomain.gov.et
FRONTEND_URL=https://console.yourdomain.gov.et

# true when HTTPS terminates in front of the app (Nginx/Caddy/load balancer)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

AI_SERVICE_URL=http://ai:8088
AI_SERVICE_KEY=replace-with-32-plus-char-shared-ai-key

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.gov.et
STAFF_FALLBACK_OTP_EMAIL=ops@yourdomain.gov.et

ACCESS_TOKEN_MINUTES=30
OTP_MINUTES=5
PLATFORM_NAME=EthioAlert
TIME_ZONE=Africa/Addis_Ababa
LOG_LEVEL=INFO
WEB_CONCURRENCY=3
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
