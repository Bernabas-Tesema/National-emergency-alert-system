# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# ── who may call this service (the backend sends this in the X-Service-Key header) ──
# Generate:  openssl rand -hex 32     Rotate by listing two keys: old,new
AI_SERVICE_KEYS=change-me-generate-with-openssl-rand-hex-32

# ── mode ──
# live    = providers first, then demo cache, then rules   (normal development)
# demo    = demo cache first, then providers, then rules   (showcase day)
# offline = demo cache, then rules, no network at all      (tests, or no internet)
AI_MODE=live
AI_ENV=dev
# synthetic = only fake data is ever sent. Change to "real" if real data ever appears:
# that disables providers whose free tier may train on prompts (Gemini free).
AI_DATA_CLASS=synthetic

# ── free provider keys (leave blank to skip a provider) ──
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER_ORDER=groq,cerebras,gemini,openrouter

# Model ids on free tiers change. Check each dashboard before demo day.
# AI_GROQ_MODEL=llama-3.3-70b-versatile
# AI_CEREBRAS_MODEL=llama-3.3-70b
# AI_GEMINI_MODEL=gemini-flash-latest
# AI_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── tuning (defaults are fine) ──
# AI_REQUEST_TIMEOUT_S=20
# AI_RATE_LIMIT_PER_MIN=120
# AI_BREAKER_FAILURES=3
# AI_BREAKER_COOLDOWN_S=60
# AI_LOG_LEVEL=INFO
